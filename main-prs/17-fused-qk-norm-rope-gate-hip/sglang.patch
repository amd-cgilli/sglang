From 6fd283288ca7c36c159af9f21c77e10f9ca96449 Mon Sep 17 00:00:00 2001
From: Christian Gilli <272772515+amd-cgilli@users.noreply.github.com>
Date: Thu, 5 Nov 2026 03:03:15 +0000
Subject: [PATCH] [Perf] [AMD] Qwen3.5: use the fused QK GemmaRMSNorm + RoPE +
 gate kernel on HIP

Route HIP attention layers with an output gate (Qwen3.5 / Qwen4-Exp target
layers and the MTP draft) to forward_prepare_cuda_fused, the existing Triton
fused_qk_gemma_rmsnorm_rope_gate kernel, instead of the unfused norm + RoPE
path. On HIP, _pdl_supported() returns False (gfx9 reports major 9 but has
no PDL), and forward_prepare_cuda_fused accepts the fused-allreduce
(fp8, scale) input tuple like forward_prepare_fused_gate does.

Draft decode (1-D positions, T=24) 66.9 -> 2.4 us per layer in a CUDA graph
on MI355X; outputs within 1 bf16 ulp of the unfused path.

Kernel-enablement half of amd-nprotaso/sglang qwen_3_8_improvement
131236277f (Chang Liu), reverted there in 30d048aa25 (Nikolai Protasov).
Its cos_sin_cache part is not needed: upstream keeps it fp32 on HIP.
---
 .../ops/attention/fused_qk_rmsnorm_rope_gate.py     |  3 ++-
 python/sglang/srt/models/qwen3_5.py                 | 13 +++++++++----
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py b/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py
index 3648bd557c..8292338080 100644
--- a/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py
+++ b/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py
@@ -17,7 +17,8 @@ from triton.language.extra.cuda import libdevice
 
 def _pdl_supported() -> bool:
     """Check if Programmatic Dependent Launch is supported (NVIDIA SM >= 90)."""
-    if not torch.cuda.is_available():
+    # ROCm reports gfx9xx as major 9 but has no PDL.
+    if not torch.cuda.is_available() or torch.version.hip is not None:
         return False
     try:
         major, _ = torch.cuda.get_device_capability()
diff --git a/python/sglang/srt/models/qwen3_5.py b/python/sglang/srt/models/qwen3_5.py
index 3306dd8db5..8508c41b8e 100644
--- a/python/sglang/srt/models/qwen3_5.py
+++ b/python/sglang/srt/models/qwen3_5.py
@@ -280,7 +280,7 @@ def _qwen3_5_stage_facts(
     )
 
 
-if _is_cuda:
+if _is_cuda or _is_hip:
     from sglang.kernels.ops.attention.fused_qk_rmsnorm_rope_gate import (
         fused_qk_gemma_rmsnorm_rope_gate,
     )
@@ -1483,6 +1483,10 @@ class Qwen3_5AttentionDecoderLayer(nn.Module):
 
     def forward_prepare_cuda_fused(self, positions, hidden_states):
         """Fused QK GemmaRMSNorm + NeoX RoPE + gate deinterleave."""
+        if _use_aiter and isinstance(hidden_states, tuple):
+            hidden_states = _select_fused_ar_input_for_linear(
+                hidden_states, self.qkv_proj
+            )
         qkv, _ = self.qkv_proj(hidden_states)
         if self.attn_output_gate:
             q_gate, k, v = qkv.split(
@@ -1505,7 +1509,8 @@ class Qwen3_5AttentionDecoderLayer(nn.Module):
             has_gate=self.attn_output_gate,
             mrope_axis_map=(self.rotary_emb.axis_map if positions.dim() == 2 else None),
         )
-        seq_len = hidden_states.shape[0]
+        # qkv, not hidden_states: the latter may be an (fp8, scale) tuple.
+        seq_len = qkv.shape[0]
         q = q_out.view(seq_len, -1)
         k = k_out.view(seq_len, -1)
         gate = gate_out.view(seq_len, -1) if gate_out is not None else None
@@ -1615,12 +1620,12 @@ class Qwen3_5AttentionDecoderLayer(nn.Module):
         hidden_states: torch.Tensor,
         forward_batch: ForwardBatch,
     ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, Optional[torch.Tensor]]:
-        if _is_cuda and self.attn_output_gate:
+        if (_is_cuda or _is_hip) and self.attn_output_gate:
             return self.forward_prepare_cuda_fused(
                 positions=positions,
                 hidden_states=hidden_states,
             )
-        if (_is_hip or _is_xpu or _is_cpu) and self.attn_output_gate:
+        if (_is_xpu or _is_cpu) and self.attn_output_gate:
             return self.forward_prepare_fused_gate(
                 positions=positions,
                 hidden_states=hidden_states,
-- 
