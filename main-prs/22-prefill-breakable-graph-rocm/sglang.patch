From 190a722948e0da8e1aea6dce2a184e7fd9386050 Mon Sep 17 00:00:00 2001
From: Christian Gilli <272772515+amd-cgilli@users.noreply.github.com>
Date: Thu, 5 Nov 2026 19:16:13 +0000
Subject: [PATCH] [Perf] [AMD] cuda graph: default prefill to breakable CUDA
 graphs on ROCm

---
 python/sglang/srt/model_executor/cuda_graph_config.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/python/sglang/srt/model_executor/cuda_graph_config.py b/python/sglang/srt/model_executor/cuda_graph_config.py
index ed481b3c70..26229c4152 100644
--- a/python/sglang/srt/model_executor/cuda_graph_config.py
+++ b/python/sglang/srt/model_executor/cuda_graph_config.py
@@ -117,10 +117,10 @@ class PhaseConfig:
 
 
 def default_prefill_backend() -> str:
-    """Enable BCG by default on CUDA; other platforms remain opt-in."""
-    from sglang.srt.utils import is_cuda
+    """Enable BCG by default on CUDA and ROCm; other platforms remain opt-in."""
+    from sglang.srt.utils import is_cuda, is_hip
 
-    return Backend.BREAKABLE if is_cuda() else Backend.DISABLED
+    return Backend.BREAKABLE if is_cuda() or is_hip() else Backend.DISABLED
 
 
 def with_phase(config: "CudaGraphConfig", phase: str, **changes) -> "CudaGraphConfig":
-- 
